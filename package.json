{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "vercel:dev": "dotenvx run -f .env.local -- cross-env HOST=127.0.0.1 PORT=3000 vercel dev --listen 3000 --debug",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ci": "vitest run --pool=forks --maxWorkers=1",
    "format": "prettier --write \"{api,server,shared,src}/**/*.{ts,tsx,css,md}\" \"*.{js,json,md}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"{api,server,shared,src}/**/*.{ts,tsx,css,md}\" \"*.{js,json,md}\" \".github/**/*.{yml,yaml}\"",
    "spellcheck": "cspell \"src/**/*.{ts,tsx}\" \"*.md\"",
    "mdlint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "knip": "knip",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@sentry/node": "^10.72.0",
    "@t3-oss/env-core": "^0.13.11",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "hono": "^4.13.5",
    "lenis": "^1.3.26",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.25.0",
    "sonner": "^2.0.8",
    "three": "^0.185.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@dotenvx/dotenvx": "^1.60.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "cspell": "^9.8.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "knip": "^6.33.0",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ]
  }
}
